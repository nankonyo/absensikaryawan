{
  "expo": {
    "name": "RST Internal App",
    "slug": "rst-internal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rstinternal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D34B52"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lokasi digunakan untuk validasi presensi kantor.",
        "NSCameraUsageDescription": "Kamera digunakan untuk foto presensi."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D34B52"
      },
      "package": "com.rst.internalapp",
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi digunakan untuk validasi presensi kantor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kamera digunakan untuk foto presensi."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D34B52",
          "image": "./assets/splash-icon.png",
          "imageWidth": 512,
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e13afb75-dd32-404f-9979-68242c18fb29"
      }
    }
  }
}
